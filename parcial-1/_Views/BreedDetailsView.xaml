<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="parcial_1._Views.BreedDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:parcial_1._ViewModels"
    x:DataType="vm:BreedDetailsViewModel"
    Title="Breed details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Label
                Text="{Binding BreedDetails.Name}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="{Binding BreedDetails.Description}"
                FontSize="16" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label
                Text="Characteristics"
                FontSize="22"
                FontAttributes="Bold" />

            <Label Text="{Binding BreedDetails.LifeMin,
                StringFormat='Life expectancy minimum: {0} years'}" />

            <Label Text="{Binding BreedDetails.LifeMax,
                StringFormat='Life expectancy maximum: {0} years'}" />

            <Label Text="{Binding BreedDetails.MaleWeightMin,
                StringFormat='Male weight minimum: {0} kg'}" />

            <Label Text="{Binding BreedDetails.MaleWeightMax,
                StringFormat='Male weight maximum: {0} kg'}" />

            <Label Text="{Binding BreedDetails.FemaleWeightMin,
                StringFormat='Female weight minimum: {0} kg'}" />

            <Label Text="{Binding BreedDetails.FemaleWeightMax,
                StringFormat='Female weight maximum: {0} kg'}" />

            <Label Text="{Binding BreedDetails.OriginCountry,
                StringFormat='Country: {0}'}" />

            <Label Text="{Binding BreedDetails.OriginRegion,
                StringFormat='Region: {0}'}" />

            <Label Text="{Binding BreedDetails.Hypoallergenic,
                StringFormat='Hypoallergenic: {0}'}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>