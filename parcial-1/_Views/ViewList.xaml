<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="parcial_1._Views.ViewList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:parcial_1._ViewModels"
    xmlns:model="clr-namespace:parcial_1._Models"
    xmlns:converters="clr-namespace:parcial_1._Converters"
    x:DataType="vm:ViewListViewModel"
    Title="Razas de perros">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BreedSelectionConverter
            x:Key="BreedSelectionConverter" />
        </ResourceDictionary>

        <Style x:Key="PressableButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="White" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />

                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#302080" />
                                <Setter Property="Scale" Value="0.97" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Gray" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="20">

        <ActivityIndicator
            Grid.Row="0"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="Red" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Breeds}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="8"
                    VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:DogBreed">
                    <Button
                        Text="{Binding Name}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectBreedCommand}"
                        CommandParameter="{Binding .}"
                        Padding="8,16"
                        BorderColor="LightGray"
                        BorderWidth="1"
                        CornerRadius="8"
                        HorizontalOptions="Fill">

                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource BreedSelectionConverter}">
                                        <Binding Path="." />
                                        <Binding
                                            Path="BindingContext.SelectedBreed"
                                            Source="{RelativeSource AncestorType={x:Type ContentPage}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter Property="BackgroundColor" Value="Black" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="8">

            <Button
                Grid.Column="0"
                Text="Buscar"
                HeightRequest="50"
                Style="{StaticResource PressableButton}"
                Command="{Binding SearchCommand}" />

            <Button
                Grid.Column="1"
                Text="Vibrar"
                HeightRequest="50"
                Style="{StaticResource PressableButton}"
                Command="{Binding VibrateCommand}" />

            <Button
                Grid.Column="2"
                Text="Ubicación"
                HeightRequest="50"
                Style="{StaticResource PressableButton}"
                Command="{Binding RequestLocationPermissionCommand}" />
        </Grid>

    </Grid>
</ContentPage>